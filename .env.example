# Runtime
DAP_APP_ENV=dev
DAP_APP_VERSION=0.7.0-calm-workspace
DAP_DEMO_MODE=true
DAP_ALLOW_DEMO_SEED=true
DAP_SECRET_KEY=replace-with-a-strong-random-secret
DAP_OPS_TOKEN=replace-with-a-strong-random-ops-token
DAP_TOKEN_TTL_MINUTES=480
DAP_CORS_ORIGINS=http://localhost:8000
DAP_LOG_LEVEL=INFO

# Hugging Face Space runtime
DAP_HF_SPACE=false
PORT=7860
# Optional: mount HF Storage Bucket to /persist and keep this unset.
# DAP_PERSIST_DIR=/persist

# Storage
DAP_DATA_DIR=./data
DAP_DB_PATH=./data/data_agent_platform.db
DAP_BUSINESS_DB_PATH=./data/business_sample.db
DAP_SQLITE_BUSY_TIMEOUT_MS=5000
DAP_SQLITE_JOURNAL_MODE=WAL
DAP_SQLITE_SYNCHRONOUS=NORMAL
DAP_SQLITE_BACKUP_MAX_AGE_HOURS=168
DAP_SQLITE_MIN_FREE_MB=256
DAP_SQLITE_INIT_LOCK_TIMEOUT_SECONDS=30

# Initial admin bootstrap. Use only when demo seed is disabled, then remove the password.
# DAP_BOOTSTRAP_ADMIN_USERNAME=admin
# DAP_BOOTSTRAP_ADMIN_PASSWORD=
# DAP_BOOTSTRAP_ADMIN_NAME=Platform Admin
# DAP_BOOTSTRAP_ADMIN_EMAIL=
# DAP_BOOTSTRAP_ADMIN_DEPARTMENT=Platform

# SQL guard
DAP_SQL_MAX_ROWS=500
DAP_SQL_TIMEOUT_MS=5000

# Rate limiting
DAP_CHAT_RATE_LIMIT_PER_MINUTE=60
DAP_AUTH_RATE_LIMIT_PER_MINUTE=20
DAP_MAX_LOGIN_FAILURES=5
DAP_LOCKOUT_MINUTES=15

# External agent host allowlist. Use comma-separated hostnames. Use '*' only in isolated dev.
DAP_ALLOWED_EXTERNAL_AGENT_HOSTS=localhost,127.0.0.1

# Codex nesting / engineering-agent handoff
# Supported: mock | http | cli | sdk
DAP_CODEX_MODE=mock
DAP_CODEX_ENDPOINT=
DAP_CODEX_WORKSPACE_ROOT=/app
DAP_CODEX_TASK_DIR=/app/data/codex_tasks
DAP_CODEX_REQUIRE_APPROVAL=true
DAP_CODEX_MAX_PROMPT_CHARS=12000

# Codex CLI runtime. Disabled by default; enable only in a controlled engineering environment.
DAP_CODEX_CLI_ENABLED=false
DAP_CODEX_CLI_COMMAND=codex
DAP_CODEX_CLI_SANDBOX=workspace-write
DAP_CODEX_CLI_APPROVAL_POLICY=never
DAP_CODEX_CLI_JSON=false
DAP_CODEX_CLI_TIMEOUT_SECONDS=1800
DAP_CODEX_CLI_PROFILE=
DAP_CODEX_CLI_MODEL=

# Codex SDK runtime. Requires local installation of the Codex SDK from the open-source Codex repo.
DAP_CODEX_SDK_ENABLED=false
DAP_CODEX_SDK_MODEL=gpt-5.4
DAP_CODEX_SDK_PYTHON_MODULE=codex_app_server
DAP_CODEX_SDK_REPO=
